# Local development only. Replace every value before using outside this machine.
POSTGRES_USER=hub_dev
POSTGRES_PASSWORD=local-only-change-this-password
POSTGRES_DB=hub_integracoes
REDIS_PASSWORD=local-only-change-this-redis-password

# Used by the API when running directly on the host.
DATABASE_URL=postgres://hub_dev:local-only-change-this-password@127.0.0.1:5433/hub_integracoes
REDIS_URL=redis://:local-only-change-this-redis-password@127.0.0.1:6380

PORT=3000
NODE_ENV=development
# Platform operator token: creates stores and issues their webhook keys and admin tokens.
PLATFORM_ADMIN_TOKEN=local-only-change-this-platform-token-32-chars
# Encrypts stored webhook secrets. 32 random bytes, base64: openssl rand -base64 32
# Losing it makes every stored webhook key unreadable (stores need new keys).
TENANT_SECRETS_KEY=bG9jYWwtb25seS1jaGFuZ2UtdGhpcy0zMi1ieXRlcyE=

# OpenAI API usage is opt-in. The dashboard's demo button can incur API charges.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=96
OPENAI_DAILY_TOKEN_LIMIT=5000
OPENAI_RESERVED_INPUT_TOKENS=256

# Enables GET /metrics and the optional Prometheus (docker compose --profile monitoring up -d).
# Empty = metrics endpoint off. Generate with: openssl rand -hex 32
METRICS_TOKEN=

# Retention (maintenance service): acknowledged stream entries kept for N hours;
# payloads of delivered orders cleared after N days (identity rows stay for dedupe).
STREAM_RETENTION_HOURS=72
DATA_RETENTION_DAYS=90
